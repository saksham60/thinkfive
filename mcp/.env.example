# Plaid
BANKING_DATA_PROVIDER=supabase
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_AUTO_BOOTSTRAP=false
PLAID_DEFAULT_CUSTOMER_ID=demo_customer_001
PLAID_INSTITUTION_ID=ins_109508
PLAID_TIMEOUT_SECONDS=10
PLAID_MAX_RETRIES=3
PLAID_WEBHOOK_REPLAY_SECONDS=300

# Shared Supabase persistence (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Optional local migration alternative when PostgreSQL ports are blocked.
# Never add this account-level token to the Render service.
SUPABASE_ACCESS_TOKEN=

# Shared external MCP authentication
MCP_AUTH_TOKEN=
MCP_PROVIDER_MODE=local

# Fraud
FRAUD_REPOSITORY_BACKEND=supabase
FRAUD_HISTORY_LIMIT=100
FRAUD_ASSESSMENT_MAX_BATCH=100
FRAUD_MAX_ALERT_RESULTS=100
FRAUD_MAX_CONCURRENT_ASSESSMENTS=20
FRAUD_ALERT_THRESHOLD=0.65
FRAUD_MEDIUM_THRESHOLD=0.35
FRAUD_HIGH_THRESHOLD=0.65
FRAUD_CRITICAL_THRESHOLD=0.85
FRAUD_ENABLE_ISOLATION_FOREST=true
FRAUD_MIN_MODEL_HISTORY=30

# Case
CASE_REPOSITORY_BACKEND=supabase
CASE_AUTO_SEED=true
CASE_ENFORCE_RBAC=true

# Combined server
MCP_AUTO_MIGRATE=false
PORT=8000
LOG_LEVEL=INFO

# Remote/distributed mode only; not required when MCP_PROVIDER_MODE=local
BANKING_MCP_URL=
BANKING_MCP_AUTH_TOKEN=
FRAUD_MCP_URL=
FRAUD_MCP_AUTH_TOKEN=

# Opt-in integration tests
RUN_PLAID_SANDBOX_TESTS=false
RUN_SUPABASE_INTEGRATION_TESTS=false
RUN_MCP_INTEGRATION_TESTS=false
