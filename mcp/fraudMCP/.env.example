BANKING_MCP_URL=http://localhost:8001/mcp
BANKING_MCP_AUTH_TOKEN=
MCP_AUTH_TOKEN=

FRAUD_MCP_MOUNT_PATH=/mcp
FRAUD_HISTORY_LIMIT=100
FRAUD_ALERT_THRESHOLD=0.65
FRAUD_MEDIUM_THRESHOLD=0.35
FRAUD_HIGH_THRESHOLD=0.65
FRAUD_CRITICAL_THRESHOLD=0.85

FRAUD_ENABLE_ISOLATION_FOREST=true
FRAUD_MIN_MODEL_HISTORY=30
FRAUD_ISOLATION_FOREST_RANDOM_STATE=42

FRAUD_ASSESSMENT_MAX_BATCH=100
FRAUD_MAX_ALERT_RESULTS=100
FRAUD_MAX_CONCURRENT_ASSESSMENTS=20

BANKING_PROVIDER_TIMEOUT_SECONDS=10
BANKING_PROVIDER_MAX_RETRIES=2
BANKING_PROVIDER_MAX_BACKOFF_SECONDS=2

FRAUD_WEIGHT_AMOUNT_ANOMALY=0.24
FRAUD_WEIGHT_VELOCITY=0.18
FRAUD_WEIGHT_MERCHANT_NOVELTY=0.14
FRAUD_WEIGHT_CATEGORY_NOVELTY=0.10
FRAUD_WEIGHT_LOCATION_ANOMALY=0.10
FRAUD_WEIGHT_ACCOUNT_BALANCE_CONTEXT=0.10
FRAUD_WEIGHT_DEVICE_RISK=0.08
FRAUD_WEIGHT_BLACKLIST_RISK=0.06

FRAUD_VELOCITY_WINDOW_HOURS=24
FRAUD_VELOCITY_COUNT_HIGH=6
FRAUD_VELOCITY_AMOUNT_MULTIPLIER_HIGH=4.0

RUN_BANKING_MCP_INTEGRATION_TESTS=false
